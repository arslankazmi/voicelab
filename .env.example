# ElevenLabs API key — leave blank to run in keyless mode (system TTS fallback)
# Get your key at https://elevenlabs.io
ELEVENLABS_API_KEY=

# Optional: bearer token for a simple auth layer (if you add auth middleware)
AUTH_TOKEN=

# Optional: comma-separated allowed CORS origins (default: * — restrict in production)
# Example: CORS_ORIGINS=https://myapp.example.com,https://staging.example.com
CORS_ORIGINS=
